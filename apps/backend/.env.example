# Backend Environment Variables Template
NODE_ENV=production
PORT=4002

DATABASE_URL="postgresql://user:password@host:5432/lokaya?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/lokaya?sslmode=require"
REDIS_URL="rediss://user:password@host:6379"

JWT_SECRET="lokaya-jwt-secret-placeholder-key-32-chars-min"
JWT_REFRESH_SECRET="lokaya-jwt-refresh-secret-placeholder-key-32-chars"
SUPER_ADMIN_JWT_SECRET="lokaya-super-admin-jwt-secret-placeholder"

CLIENT_URL="https://lokaya.shop"
FRONTEND_URL="https://lokaya.shop,https://www.lokaya.shop,https://admin.lokaya.shop,https://lokaya-user-app.pages.dev,https://lokaya-admin-app.pages.dev"
ADMIN_URL="https://admin.lokaya.shop"

ADMIN_EMAIL="admin@lokaya.shop"
ADMIN_PASSWORD="AdminPassword123!"

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

RAZORPAY_KEY_ID="rzp_live_yourKeyId"
RAZORPAY_KEY_SECRET="yourRazorpaySecret"
RAZORPAY_WEBHOOK_SECRET="yourWebhookSecret"
RAZORPAY_WEBHOOK_URL="https://api.lokaya.shop/api/v1/payments/webhook"

CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="lokaya-cdn"
NEXT_PUBLIC_CDN_DOMAIN="https://cdn.lokaya.shop"

AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="simplicion.com@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SECURE="true"
SMTP_FROM_EMAIL="simplicion.com@gmail.com"
