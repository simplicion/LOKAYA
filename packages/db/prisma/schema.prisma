generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum StoreStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURNED
  REFUNDED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  PHONE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}


enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

// User & Identity
model User {
  id           String       @id @default(uuid())
  email        String?      @unique
  phone        String?      @unique
  password     String?
  name         String
  avatarUrl    String?
  googleId     String?      @unique
  authProvider AuthProvider @default(LOCAL)
  
  // Capabilities
  isSystemAdmin Boolean     @default(false)

  // Profile & Onboarding details
  age          Int?
  gender       String?      // 'MALE' | 'FEMALE' | 'OTHER' | 'PREFER_NOT_TO_SAY'
  city         String?
  state        String?
  latitude     Float?
  longitude    Float?
  locationArea String?
  
  stores       StoreUser[]
  orders       Order[]
  carts        Cart[]
  deliveryPartner DeliveryPartner?
  
  // Social
  posts        Post[]
  reels        Reel[]
  likes        Like[]
  comments     Comment[]
  reports      Report[]
  
  followers    Follow[] @relation("UserFollowers")
  following    Follow[] @relation("UserFollowing")
  
  reviews      Review[]
  wishlistItems WishlistItem[]
  stories      Story[]      @relation("UserStories")
  storyViews   StoryView[]
  storyLikes   StoryLike[]
  savedPosts   SavedPost[]
  addresses    Address[]
  supportTickets SupportTicket[]
  deviceTokens DeviceToken[]
  notifications Notification[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Store / Seller Workspace
model Store {
  id            String      @id @default(uuid())
  name          String
  handle        String?     @unique
  address       String
  pincode       String?
  city          String?
  state         String?
  pickupLocationNickname String?
  gstNumber     String?
  upiId         String?
  latitude      Float?
  longitude     Float?
  category      String?
  landmark      String?
  businessType  String?
  aadharPanUrl  String?
  aadhaarFrontUrl String?
  aadhaarBackUrl  String?
  panCardUrl      String?
  storefrontUrl String?
  bannerUrl     String?
  logoUrl       String?
  title         String?
  description   String?
  contactPhone  String?
  gstOrLicenseUrl String?
  shopPhotos    String[]    @default([])
  isActive      Boolean     @default(true)
  openingTime   String?
  closingTime   String?
  themeColor    String?     @default("#059669")
  secondaryColor String?    @default("#fcd34d")
  workingDays   Int[]       @default([1, 2, 3, 4, 5, 6, 0]) // 0=Sun, 1=Mon...
  minimumOrder  Float?      @default(0)
  acceptedPayments String[] @default(["ONLINE PAYMENT", "CASH"])
  status        StoreStatus @default(PENDING)
  isVerified    Boolean     @default(false)
  verificationStatus String  @default("NOT_APPLIED") // "NOT_APPLIED" | "PENDING" | "APPROVED" | "REJECTED"
  verificationRequestedAt DateTime?
  
  users         StoreUser[]
  products      Product[]
  orders        Order[]
  subOrders     SubOrder[]
  categories    Category[]
  reviews       Review[]    @relation("StoreReviews")
  bankAccounts  SellerBankAccount[]
  payouts       SellerPayout[]
  transactions  SellerTransaction[]
  notifications SellerNotification[]
  stories       Story[]
  highlights    Highlight[]
  deliveryPartners StoreDeliveryPartner[]
  deliveryBatches DeliveryBatch[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StoreUser {
  userId    String
  storeId   String
  user      User     @relation(fields: [userId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])

  @@id([userId, storeId])
}

// Catalog
model Product {
  id            String   @id @default(uuid())
  storeId       String
  name          String
  slug          String?  @unique
  brand         String?
  brandId       String?
  description   String?
  category      String?
  categoryId    String?
  categoryModel Category? @relation(fields: [categoryId], references: [id])
  sku           String   @unique
  qrUuid        String?  @unique
  
  // Legacy fields (kept for backward compatibility during v1 -> v2 transition)
  mrp           Float    @default(0)
  sellingPrice  Float    @default(0)
  stockCount    Int      @default(0)
  imageUrl      String?

  // V2 Fields
  productType   String?  @default("PHYSICAL")
  status        ProductStatus @default(DRAFT)
  hasVariants   Boolean  @default(false)
  isAvailableForDelivery Boolean @default(true)
  isAvailableForPickup   Boolean @default(true)
  isDeliveryIncluded     Boolean @default(false)
  costPrice              Float?  @default(0)
  processingTime String?

  // Verification Center Fields
  isVerified              Boolean   @default(false)
  verificationStatus      String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  verificationRequestedAt DateTime?
  rejectionReason         String?

  store         Store    @relation(fields: [storeId], references: [id])
  variants      ProductVariant[]
  media         ProductMedia[]
  attributes    ProductAttributeValue[]
  
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]
  cartItems     CartItem[]
  productLinks  ProductLink[]
  reviews       Review[] @relation("ProductReviews")
  wishlistItems WishlistItem[]
  stories       Story[]

  isActive      Boolean  @default(true) // Legacy status flag
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeId])
  @@index([categoryId])
  @@index([isActive, status, createdAt])
}

model ProductMedia {
  id          String   @id @default(uuid())
  productId   String
  url         String
  type        MediaType @default(IMAGE)
  displayOrder Int      @default(0)
  isPrimary   Boolean  @default(false)
  
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, displayOrder])
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String
  name           String
  sku            String   @unique
  barcode        String?
  imageUrl       String?
  price          Float
  compareAtPrice Float?
  costPrice      Float?
  weight         Float?
  
  // Legacy
  stockCount     Int      @default(0)
  
  status         VariantStatus @default(ACTIVE)
  
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory[]
  orderItems     OrderItem[]
  cartItems      CartItem[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId, status])
}

model Category {
  id            String    @id @default(uuid())
  storeId       String
  name          String
  description   String?
  imageUrl      String?
  displayOrder  Int       @default(1)
  isActive      Boolean   @default(true)
  
  store         Store     @relation(fields: [storeId], references: [id])
  products      Product[]
  attributes    CategoryAttribute[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([storeId, displayOrder])
}

model CategoryAttribute {
  id          String    @id @default(uuid())
  categoryId  String
  name        String    // e.g., "Size", "Color"
  type        String    @default("TEXT") // TEXT, NUMBER, SELECT
  options     String[]  @default([]) // e.g., ["S", "M", "L"]
  isRequired  Boolean   @default(false)
  
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productValues ProductAttributeValue[]

  createdAt   DateTime  @default(now())
}

model ProductAttributeValue {
  id          String    @id @default(uuid())
  productId   String
  attributeId String
  value       String
  
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  
  @@unique([productId, attributeId])
}

// Inventory
model Inventory {
  id          String   @id @default(uuid())
  variantId   String
  locationId  String?  // Nullable for now, default to store's main location
  available   Int      @default(0)
  reserved    Int      @default(0)
  threshold   Int      @default(10)
  
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([variantId, locationId])
}

model InventoryLog {
  id        String   @id @default(uuid())
  productId String
  variantId String?
  change    Int
  reason    String
  
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

// Coupon
model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue Float
  minCartValue  Float?
  maxDiscount   Float?
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  isActive      Boolean   @default(true)
  usageLimit    Int?
  usedCount     Int       @default(0)

  carts         Cart[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Cart
model Cart {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  
  couponId  String?
  coupon    Coupon?    @relation(fields: [couponId], references: [id])

  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id          String   @id @default(uuid())
  cartId      String
  productId   String
  variantId   String?
  quantity    Int

  cart        Cart            @relation(fields: [cartId], references: [id])
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([cartId, productId, variantId])
}

// Saved Customer Addresses
model Address {
  id           String   @id @default(uuid())
  userId       String
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  type         String   @default("HOME")
  isDefault    Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// Order & Checkout
model Order {
  id                  String      @id @default(uuid())
  buyerId             String
  storeId             String
  status              OrderStatus @default(PENDING)
  totalAmount         Float
  shippingFee         Float       @default(0)
  platformFee         Float       @default(0)
  paymentMethod       String?     @default("ONLINE")
  pickupToken         String?     @unique
  deliveryAddress     String?
  
  // Shiprocket 3PL Logistics
  shiprocketOrderId   String?
  shiprocketShipmentId String?
  awbCode             String?
  courierName         String?
  shippingLabelUrl    String?
  trackingUrl         String?
  estimatedDelivery   String?
  
  // Manual In-Store POS Booking & Enterprise Invoicing
  isManualBooking     Boolean     @default(false)
  customerName        String?
  customerPhone       String?
  customerEmail       String?
  discountAmount      Float?      @default(0)
  invoiceNumber       String?     @unique
  notes               String?
  
  buyer         User        @relation(fields: [buyerId], references: [id])
  store         Store       @relation(fields: [storeId], references: [id])
  items         OrderItem[]
  subOrders     SubOrder[]
  batchItems    DeliveryBatchItem[]
  payment       Payment?
  pickupOtp     OrderPickupOtp?
  transactions  SellerTransaction[]

  // Hyperlocal Delivery Lifecycle & Verification
  deliveryOtp         String?
  fulfillmentType     FulfillmentType?
  deliveryPartnerId   String?
  deliveryPartner     DeliveryPartner?     @relation("OrderDeliveryPartner", fields: [deliveryPartnerId], references: [id])
  deliveryAssignments DeliveryAssignment[]
  pickedUpAt          DateTime?
  outForDeliveryAt    DateTime?
  deliveredAt         DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SubOrder {
  id                         String      @id @default(uuid())
  orderId                    String
  storeId                    String
  status                     OrderStatus @default(PENDING)
  subtotal                   Float
  commissionAmount           Float       @default(0)
  platformMarginCommission   Float       @default(0)
  sellerPayoutAmount         Float       @default(0)
  shippingCollected          Float       @default(0)
  shippingPaidToRider        Float       @default(0)
  shippingMerchantProfit     Float       @default(0)
  invoiceNumber              String?
  
  // Shiprocket 3PL Tracking
  shiprocketOrderId   String?
  shiprocketShipmentId String?
  awbCode             String?
  courierName         String?
  shippingLabelUrl    String?
  trackingUrl         String?

  order               Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store               Store       @relation(fields: [storeId], references: [id])
  items               OrderItem[]
  batchItems          DeliveryBatchItem[]

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([orderId])
  @@index([storeId])
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  subOrderId    String?
  productId     String
  variantId     String?
  quantity      Int
  
  // Snapshots
  productName   String
  sku           String
  priceAt       Float
  
  order         Order           @relation(fields: [orderId], references: [id])
  subOrder      SubOrder?       @relation(fields: [subOrderId], references: [id])
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([orderId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  provider          String        @default("RAZORPAY")
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  providerSignature String?

  order             Order         @relation(fields: [orderId], references: [id])
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// Content (Posts & Reels)
model MediaAsset {
  id          String    @id @default(uuid())
  url         String    // Final CDN URL (or placeholder if pending)
  type        MediaType
  
  status      MediaProcessingStatus @default(PENDING)
  originalUrl String?   // Raw S3 URL
  posterUrl   String?   // Video thumbnail
  duration    Int?      // In seconds
  sizeBytes   Int?
  errorMsg    String?
  
  post        Post?     @relation(fields: [postId], references: [id])
  postId      String?
  reel        Reel?     @relation(fields: [reelId], references: [id])
  reelId      String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([postId])
  @@index([reelId])
}

model Post {
  id          String        @id @default(uuid())
  authorId    String
  caption     String?
  
  author      User          @relation(fields: [authorId], references: [id])
  media       MediaAsset[]
  productLinks ProductLink[]
  likes       Like[]
  comments    Comment[]
  reports     Report[]
  savedPosts  SavedPost[]
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([authorId, createdAt])
}

model Reel {
  id          String        @id @default(uuid())
  authorId    String
  caption     String?
  
  author      User          @relation(fields: [authorId], references: [id])
  media       MediaAsset[]
  productLinks ProductLink[]
  likes       Like[]
  comments    Comment[]
  reports     Report[]
  savedPosts  SavedPost[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([authorId, createdAt])
}

model ProductLink {
  id        String   @id @default(uuid())
  productId String
  postId    String?
  reelId    String?

  product   Product  @relation(fields: [productId], references: [id])
  post      Post?    @relation(fields: [postId], references: [id])
  reel      Reel?    @relation(fields: [reelId], references: [id])
}

// Social
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id])
  following   User     @relation("UserFollowers", fields: [followingId], references: [id])
  
  createdAt   DateTime @default(now())
  
  @@unique([followerId, followingId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  reelId    String?

  user      User     @relation(fields: [userId], references: [id])
  post      Post?    @relation(fields: [postId], references: [id])
  reel      Reel?    @relation(fields: [reelId], references: [id])
  
  createdAt DateTime @default(now())
  
  @@unique([userId, postId, reelId])
  @@index([postId, userId])
  @@index([reelId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  postId    String?
  reelId    String?

  user      User     @relation(fields: [userId], references: [id])
  post      Post?    @relation(fields: [postId], references: [id])
  reel      Reel?    @relation(fields: [reelId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([reelId, createdAt])
}

// Review & Reputation
model Review {
  id          String   @id @default(uuid())
  userId      String
  productId   String?
  storeId     String?
  rating      Int
  comment     String?
  
  user        User     @relation(fields: [userId], references: [id])
  product     Product? @relation("ProductReviews", fields: [productId], references: [id])
  store       Store?   @relation("StoreReviews", fields: [storeId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, createdAt])
  @@index([storeId, createdAt])
  @@index([userId])
}

model Report {
  id        String   @id @default(uuid())
  reason    String
  userId    String
  postId    String?
  reelId    String?
  status    String   @default("PENDING")

  user      User     @relation(fields: [userId], references: [id])
  post      Post?    @relation(fields: [postId], references: [id])
  reel      Reel?    @relation(fields: [reelId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Wishlist
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  
  @@unique([userId, productId])
}

// ----------------------------------------------------
// Seller Platform Extensions (Production-Grade)
// ----------------------------------------------------

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TransactionType {
  CREDIT
  DEBIT
  PAYOUT
}

enum NotificationType {
  ORDER
  SYSTEM
  ALERT
  PAYOUT
}

model SellerBankAccount {
  id            String         @id @default(uuid())
  storeId       String
  accountName   String
  bankName      String
  accountNumber String         // Masked e.g., "****9042"
  fullAccount   String?
  ifsc          String
  isPrimary     Boolean        @default(false)
  isVerified    Boolean        @default(true)
  
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payouts       SellerPayout[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([storeId])
}

model SellerPayout {
  id              String            @id @default(uuid())
  storeId         String
  bankAccountId   String
  amount          Float
  fee             Float             @default(0)
  status          PayoutStatus      @default(PENDING)
  referenceNumber String?           @unique
  failureReason   String?

  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  bankAccount     SellerBankAccount @relation(fields: [bankAccountId], references: [id])

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([storeId])
}

model SellerTransaction {
  id          String          @id @default(uuid())
  storeId     String
  orderId     String?
  title       String
  amount      Float
  type        TransactionType
  description String?

  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order       Order?          @relation(fields: [orderId], references: [id])

  createdAt   DateTime        @default(now())

  @@index([storeId, createdAt])
}

model SellerNotification {
  id        String           @id @default(uuid())
  storeId   String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  linkUrl   String?

  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())

  @@index([storeId, isRead])
}

model OrderPickupOtp {
  id        String   @id @default(uuid())
  orderId   String   @unique
  otpCode   String   // 4-digit code e.g., "4829"
  qrToken   String   @unique
  isUsed    Boolean  @default(false)
  expiresAt DateTime

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Stories & Highlights
model Story {
  id             String          @id @default(uuid())
  storeId        String
  authorId       String
  mediaUrl       String
  fileKey        String?
  mediaType      MediaType       @default(IMAGE)
  caption        String?
  productId      String?

  // Expiration & Archival Lifecycle
  expiresAt      DateTime
  isArchived     Boolean         @default(false)
  archivedAt     DateTime?
  purgeAt        DateTime
  isPurged       Boolean         @default(false)

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  author         User            @relation("UserStories", fields: [authorId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  views          StoryView[]
  likes          StoryLike[]
  highlightItems HighlightItem[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([storeId, expiresAt])
  @@index([storeId, isArchived])
  @@index([purgeAt, isPurged])
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  viewerId  String

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId])
}

model StoryLike {
  id        String   @id @default(uuid())
  storyId   String
  userId    String

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
}

model Highlight {
  id        String          @id @default(uuid())
  storeId   String
  title     String
  coverUrl  String?

  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     HighlightItem[]

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([storeId])
}

model HighlightItem {
  id           String    @id @default(uuid())
  highlightId  String
  storyId      String
  displayOrder Int       @default(0)

  highlight    Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  story        Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())

  @@unique([highlightId, storyId])
  @@index([highlightId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  reelId    String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  reel      Reel?    @relation(fields: [reelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId, reelId])
  @@index([userId])
}

// Banners & Promotional Content
model Banner {
  id           String    @id @default(uuid())
  title        String
  subtitle     String?
  tagline      String?
  imageUrl     String
  linkUrl      String?   // Target URL e.g. /product/123, /store/456, /search?q=shoes
  buttonText   String?   @default("Shop Now")
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  startDate    DateTime?
  endDate      DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, displayOrder])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  category     String         // 'ORDER', 'PAYMENT', 'DELIVERY', 'SELLER', 'ACCOUNT', 'OTHER'
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  description  String
  orderId      String?
  attachments  String[]       @default([])
  adminNotes   String?
  
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

// ----------------------------------------------------
// Hyperlocal Delivery Ecosystem Models
// ----------------------------------------------------

enum DeliveryPartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  SCOOTER
  EV
  CAR
  VAN
  WALKER
}

enum PartnerRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DeliveryAssignmentStatus {
  ASSIGNED
  ACCEPTED
  ARRIVED_AT_STORE
  PICKED_UP
  OUT_FOR_DELIVERY
  ARRIVED_AT_CUSTOMER
  DELIVERED
  REJECTED
  CANCELLED
  EXPIRED
}

enum FulfillmentType {
  LOKAYA_AUTO
  LOKAYA_PARTNER
  SELF_DELIVERY
}

model DeliveryPartner {
  id                    String                @id @default(uuid())
  userId                String                @unique
  status                DeliveryPartnerStatus @default(PENDING)
  isOnline              Boolean               @default(false)
  isBusy                Boolean               @default(false)
  
  // Real-time location
  currentLatitude       Float?
  currentLongitude      Float?
  locationArea          String?
  lastLocationUpdate    DateTime?

  // Vehicle Details
  vehicleType           VehicleType           @default(MOTORCYCLE)
  vehicleNumber         String
  vehiclePhotoUrl       String?
  vehicleDocumentUrl    String?

  // Dynamic Custom Pricing
  perKmRate             Float                 @default(8.0)
  baseFare              Float                 @default(40.0)
  isCustomPricingEnabled Boolean              @default(true)
  operatingCountry      String                @default("IN")

  // Identity & KYC (optional for fast-track startup onboarding)
  selfieUrl             String?
  identityDocumentType  String                @default("GOVERNMENT_ID")
  identityDocumentUrl   String?
  rejectionReason       String?

  // Metrics & Stats
  totalDeliveries       Int                   @default(0)
  rating                Float                 @default(5.0)
  totalEarnings         Float                 @default(0)

  // Relations
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments           DeliveryAssignment[]
  partnerStores         StoreDeliveryPartner[]
  fulfilledOrders       Order[]               @relation("OrderDeliveryPartner")
  deliveryBatches       DeliveryBatch[]
  bankAccounts          RiderBankAccount[]
  payouts               RiderPayout[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([status, isOnline, isBusy])
  @@index([currentLatitude, currentLongitude])
}

model RiderBankAccount {
  id                String          @id @default(uuid())
  deliveryPartnerId String
  accountName       String
  bankName          String
  accountNumber     String          // Masked e.g., "****9042"
  fullAccount       String?
  ifsc              String
  isPrimary         Boolean         @default(false)
  isVerified        Boolean         @default(true)

  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  payouts           RiderPayout[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([deliveryPartnerId])
}

model RiderPayout {
  id                String           @id @default(uuid())
  deliveryPartnerId String
  bankAccountId     String
  amount            Float
  fee               Float            @default(0)
  status            PayoutStatus     @default(PENDING)
  referenceNumber   String?          @unique
  failureReason     String?

  deliveryPartner   DeliveryPartner  @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  bankAccount       RiderBankAccount @relation(fields: [bankAccountId], references: [id])

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([deliveryPartnerId])
}

model StoreDeliveryPartner {
  id                String               @id @default(uuid())
  storeId           String
  deliveryPartnerId String
  status            PartnerRequestStatus @default(PENDING)
  notes             String?
  initiatedBy       String               @default("RIDER")
  
  store             Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveryPartner   DeliveryPartner      @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([storeId, deliveryPartnerId])
  @@index([storeId, status])
  @@index([deliveryPartnerId, status])
}

model DeliveryAssignment {
  id                String                   @id @default(uuid())
  orderId           String
  deliveryPartnerId String
  status            DeliveryAssignmentStatus @default(ASSIGNED)
  
  assignedAt        DateTime                 @default(now())
  acceptedAt        DateTime?
  arrivedStoreAt    DateTime?
  pickedUpAt        DateTime?
  outForDeliveryAt  DateTime?
  arrivedCustomerAt DateTime?
  deliveredAt       DateTime?
  deliveryFee       Float                    @default(0)

  order             Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartner   DeliveryPartner          @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)

  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([orderId])
  @@index([deliveryPartnerId, status])
}

model CountryFuelBenchmark {
  countryCode            String   @id
  countryName            String
  currency               String
  currencySymbol         String   @default("₹")
  fuelPricePerLiter      Float
  standardBikeMileage    Float    @default(50.0)
  standardScooterMileage Float    @default(40.0)
  baseLaborAllowance     Float    @default(1.0)
  lastUpdated            DateTime @default(now())

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

enum BatchDispatchStatus {
  PENDING
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model DeliveryBatch {
  id                     String              @id @default(uuid())
  storeId                String
  store                  Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveryPartnerId      String?
  deliveryPartner        DeliveryPartner?    @relation(fields: [deliveryPartnerId], references: [id])
  status                 BatchDispatchStatus @default(PENDING)
  totalDrops             Int                 @default(1)
  completedDrops         Int                 @default(0)
  totalShippingCollected Float               @default(0)
  totalRiderPayout       Float               @default(0)
  totalMerchantProfit    Float               @default(0)
  
  items                  DeliveryBatchItem[]
  
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([storeId])
  @@index([deliveryPartnerId, status])
  @@index([status])
}

model DeliveryBatchItem {
  id                 String        @id @default(uuid())
  batchId            String
  batch              DeliveryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrderId         String?
  subOrder           SubOrder?     @relation(fields: [subOrderId], references: [id])
  dropSequence       Int           @default(1)
  shippingCollected  Float         @default(0)
  riderShare         Float         @default(0)
  merchantShare      Float         @default(0)
  isFirstDrop        Boolean       @default(false)
  isCompleted        Boolean       @default(false)
  completedAt        DateTime?
  customerOtp        String?
  
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([batchId])
  @@index([orderId])
}

// Country Fuel Rates Management (Global Benchmark Endpoint)
model CountryFuelRate {
  id                String   @id @default(uuid())
  countryCode       String   @unique // ISO 3166-1 alpha-2 (e.g. "NP", "IN", "US", "AE", etc.)
  countryName       String   // e.g. "Nepal", "India", "United States", "United Arab Emirates"
  currency          String   // ISO 4217, e.g. "NPR", "INR", "USD", "AED", "GBP"
  currencySymbol    String   // e.g. "रू", "₹", "$", "AED", "£"
  fuelPricePerLiter Float    // Current retail fuel price per liter in local currency
  isActive          Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@index([countryCode])
  @@index([isActive])
}

// ==========================================
// Push Notifications & Device Token Registry
// ==========================================

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

model DeviceToken {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String         @unique
  platform    DevicePlatform @default(ANDROID)
  deviceModel String?
  osVersion   String?
  appVersion  String?
  isActive    Boolean        @default(true)
  lastUsedAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([token])
  @@index([platform, isActive])
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  imageUrl    String?
  deepLink    String?   // e.g. "/orders/abc/track", "/store/store-id", "/product/prod-id", "/reel/reel-id"
  type        String    @default("SYSTEM") // "ORDER_UPDATE" | "DELIVERY_DISPATCH" | "NEW_PRODUCT" | "NEW_STORY" | "NEW_POST" | "MARKETING" | "SYSTEM"
  data        Json?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
}

model NotificationCampaign {
  id             String    @id @default(uuid())
  title          String
  body           String
  imageUrl       String?
  deepLink       String?
  targetAudience String    // "ALL_USERS" | "STORE_OWNERS" | "RIDERS" | "CUSTOM_SEGMENT" | "SPECIFIC_USER"
  targetFilter   Json?     // e.g. { city: "Kathmandu", countryCode: "NP" } or { userId: "..." }
  sentCount      Int       @default(0)
  successCount   Int       @default(0)
  failureCount   Int       @default(0)
  status         String    @default("SENT") // "DRAFT" | "PROCESSING" | "SENT" | "FAILED"
  scheduledAt    DateTime?
  sentAt         DateTime  @default(now())
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model SearchLog {
  id             String   @id @default(uuid())
  keyword        String   @unique
  count          Int      @default(1)
  lastSearchedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([count])
  @@index([lastSearchedAt])
}

