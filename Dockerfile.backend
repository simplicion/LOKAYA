FROM node:20-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

FROM base AS builder
WORKDIR /app

# Install build essentials for native packages and OpenSSL for Prisma
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    python3 \
    make \
    g++ \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 1. Copy workspace manifests first for optimal layer caching
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/db/package.json ./packages/db/
COPY packages/common/package.json ./packages/common/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY apps/backend/package.json ./apps/backend/

# 2. Install dependencies
RUN pnpm install --frozen-lockfile

# 3. Copy packages and generate Prisma client
COPY packages/db ./packages/db
COPY packages/common ./packages/common
COPY packages/typescript-config ./packages/typescript-config
RUN pnpm --filter @workspace/db run generate

# 4. Copy backend source code and compile TypeScript
COPY apps/backend ./apps/backend
RUN pnpm --filter backend run build

# 5. Production Runner Stage
FROM node:20-bookworm-slim AS runner
WORKDIR /app

# Install runtime dependencies: ffmpeg for video transcoding, openssl for Prisma, curl for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    openssl \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV PORT=4002

# Copy monorepo structure from builder
COPY --from=builder /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/db ./packages/db
COPY --from=builder /app/packages/common ./packages/common
COPY --from=builder /app/apps/backend/package.json ./apps/backend/
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/backend/node_modules ./apps/backend/node_modules

# Add entrypoint
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 4002

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:4002/health || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "apps/backend/dist/index.js"]
