# ==============================================================================
# LOKAYA Monorepo - Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4101
NEXT_PUBLIC_API_URL="http://localhost:4101/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4101"

# ------------------------------------------------------------------------------
# Database & Cache
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lokaya_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lokaya_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET="lokaya-jwt-secret-placeholder-key-32-chars-min"
JWT_REFRESH_SECRET="lokaya-jwt-refresh-secret-placeholder-key-32-chars"
SUPER_ADMIN_JWT_SECRET="lokaya-super-admin-jwt-secret-placeholder"
NEXTAUTH_SECRET="lokaya-nextauth-secret-placeholder-key"
NEXTAUTH_URL="http://localhost:3101"

# Initial Admin Credentials (for seed/setup scripts)
ADMIN_EMAIL="admin@lokaya.com"
ADMIN_PASSWORD="AdminPassword123!"

# ------------------------------------------------------------------------------
# Application URLs & CORS
# ------------------------------------------------------------------------------
CLIENT_URL="http://localhost:3101"
FRONTEND_URL="http://localhost:3101,http://localhost:3102,http://localhost:3103,http://localhost:3000,http://localhost:3001,http://localhost:3002"
ADMIN_URL="http://localhost:3102"

# ------------------------------------------------------------------------------
# OAuth (Google)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_placeholderKeyId123"
RAZORPAY_KEY_SECRET="rzp_test_placeholderSecretKey456"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"
RAZORPAY_WEBHOOK_URL="http://localhost:4101/api/v1/payments/webhook"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholderKeyId123"

# ------------------------------------------------------------------------------
# Storage - Cloudflare R2 / AWS S3
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="lokaya-media"
R2_ENDPOINT="https://your-r2-account-id.r2.cloudflarestorage.com"

# AWS S3 / Media Processing Fallback
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_RAW_BUCKET="lokaya-raw-media"
AWS_S3_PROCESSED_BUCKET="lokaya-processed-media"
NEXT_PUBLIC_CDN_DOMAIN="https://cdn.lokaya.com"
REELS_CDN_URL="https://cdn.lokaya.com/reels"

# ------------------------------------------------------------------------------
# Email / SMTP
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER="placeholder_user@ethereal.email"
SMTP_PASS="placeholder_password"
SMTP_SECURE="false"
SMTP_FROM_EMAIL="no-reply@lokaya.com"
EMAIL_FROM="no-reply@lokaya.com"
